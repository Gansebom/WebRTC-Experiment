# Copy to .env and fill in. Never commit .env.

# Passcode the app asks for before it shows anything. Use a long random string.
APP_PASSCODE=

# Anthropic API key (Claude talks to the Atlas MCP server for you).
ANTHROPIC_API_KEY=

# Tanium Atlas MCP server. Copy the endpoint from the MCP panel on the Atlas
# page in your Tanium Cloud console. It looks like:
#   https://<your-domain>-api.cloud.tanium.com/mcp
TANIUM_MCP_URL=

# Authentication to the MCP server - use ONE of these:
# (a) a static bearer token
TANIUM_MCP_TOKEN=
# (b) an OAuth client registered in Tanium Atlas (client-credentials grant)
TANIUM_OAUTH_TOKEN_URL=
TANIUM_OAUTH_CLIENT_ID=
TANIUM_OAUTH_CLIENT_SECRET=
TANIUM_OAUTH_SCOPE=

# Optional
# PORT=8787
# ATLAS_MODEL=claude-opus-5-5
# ATLAS_EFFORT=medium        # low | medium | high | xhigh | max
# DATA_DIR=./data/conversations
